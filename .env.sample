# Bot wallet mnemonic — 24-word BIP39 phrase.
# The wallet must be a Realio account (eth_secp256k1, coin type 60).
# Derive the address: DRY_RUN=true node compound.mjs  (printed as "Bot address:")
# Fund it with enough RIO to cover gas (~0.001 RIO per delegator per run).
MNEMONIC=word1 word2 word3 ... word24

# Minimum pending reward (in ario, 18 decimals) before compounding a delegator.
# Default: 1000000000000000000 (1 RIO). Lower values increase gas spend per run.
# MIN_REWARD=1000000000000000000

# Set to "false" to broadcast transactions. Any other value (default) = dry run only.
# DRY_RUN=true
