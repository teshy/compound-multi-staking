{
  "name": "compound-multi-staking",
  "version": "1.0.0",
  "description": "Code-review copy of the compound path behind compound.teshy.com: the grant page’s wallet-facing code (page/) and the auto-compound bot (scripts/, src/). Not packaged for hosting.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs && npm --prefix page test",
    "lint": "eslint .",
    "format": "prettier --write test eslint.config.js",
    "format:check": "prettier --check test eslint.config.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "17.13.0",
    "prettier": "^3.9.9"
  },
  "dependencies": {
    "@cosmjs/amino": "0.30.1",
    "@cosmjs/crypto": "0.30.1",
    "@cosmjs/encoding": "0.30.1",
    "@cosmjs/proto-signing": "^0.30.1",
    "@cosmjs/stargate": "^0.30.1",
    "@cosmjs/utils": "0.30.1",
    "@ethersproject/bytes": "5.8.0",
    "@ethersproject/keccak256": "5.8.0",
    "@ethersproject/wallet": "^5.7.0",
    "axios": "^1.20.0",
    "axios-retry": "^3.4.0",
    "compare-versions": "^5.0.3",
    "cosmjs-types": "^0.7.1",
    "dotenv": "^16.0.3",
    "lodash": "^4.17.21",
    "mathjs": "^11.7.0",
    "winston": "^3.19.0"
  },
  "overrides": {
    "protobufjs": "^7.6.5",
    "axios": "^1.20.0"
  }
}
